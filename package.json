
{
  "name": "ols-profile-switcher",
  "displayName": "OLS Profile Switcher",
  "description": "Switch Odin Language Server profiles from the VS Code status bar.",
  "keywords": [
    "odin",
    "odin-language-server",
    "ols",
    "language-server",
    "profile",
    "profile-switcher",
    "configuration",
    "developer-tools",
    "vscode"
  ],
  "version": "1.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Psycho345/ols-profile-switcher"
  },
  "publisher": "Psycho345",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:ols.json",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "olsProfileSwitcher.selectProfile",
        "title": "OLS: Select Profile"
      },
      {
        "command": "olsProfileSwitcher.refresh",
        "title": "OLS: Refresh Profile"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "echo No build required"
  }
}